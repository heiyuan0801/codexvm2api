ARG RUST_IMAGE=rust:1.97-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
FROM ${RUST_IMAGE} AS builder
WORKDIR /app/backend
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/apps ./apps
COPY backend/crates ./crates
COPY backend/migrations ./migrations
COPY release/version.yaml /app/release/version.yaml
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/backend/target \
    cargo build --locked --release -p codex-slot-sidecar \
    && cp target/release/codex-slot-sidecar /tmp/codex-slot-sidecar

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/cpr-slot/secrets /var/lib/cpr-slot/home
COPY --from=builder /tmp/codex-slot-sidecar /usr/local/bin/codex-slot-sidecar
ENV HOME=/var/lib/cpr-slot/home
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/codex-slot-sidecar"]
